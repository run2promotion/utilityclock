# Copy to .env.local for development — NEVER commit secrets.

# Canonical URL (no trailing slash). Use the hostname visitors/bookmarks primarily see:
# e.g. https://www.utilityclock.com if www is primary (recommended if nginx/cert routes www → Node).
NEXT_PUBLIC_SITE_URL=https://www.utilityclock.com

# Optional. Middleware rejects Host headers not in this list when set.
# Include BOTH apex + www if either may reach Node behind HTTPS terminating proxies:
ALLOWED_HOSTS=utilityclock.com,www.utilityclock.com,localhost,127.0.0.1

# Feature flags (0/1). See src/lib/feature-flags.ts for names.
# NEXT_PUBLIC_FLAG_STUDY_CLUSTER_LINKS=1
# NEXT_PUBLIC_FLAG_WORKFLOW_MODES=0
# NEXT_PUBLIC_FLAG_RETENTION_LAYER=0
# NEXT_PUBLIC_FLAG_PWA_RELIABILITY=0
# NEXT_PUBLIC_FLAG_AD_EXPERIMENTS=0
# NEXT_PUBLIC_FLAG_LOCALE_KEYWORDS=0
